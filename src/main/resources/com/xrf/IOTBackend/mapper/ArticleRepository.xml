<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xrf.iotbackend.repository.ArticleRepository">

    <resultMap id="articleListItem" type="com.xrf.iotbackend.model.vo.ArticleListVO">
        <id property="id" column="id"/>
        <result property="title" column="title"/>
        <result property="coverUrl" column="cover_url"/>
        <result property="createTime" column="create_time"/>
        <result property="commentCount" column="comment_count"/>

        <association property="author" javaType="com.xrf.iotbackend.model.vo.AuthorVO">
            <id property="id" column="author_id"/>
            <result property="username" column="author_username"/>
        </association>

        <association property="category" javaType="com.xrf.iotbackend.model.vo.CategorySimpleVO">
            <id property="id" column="category_id"/>
            <result property="name" column="category_name"/>
        </association>
    </resultMap>

    <select id="countArticlePage" resultType="long">
        select count(*) from articles a join users u on a.author_id = u.id join categories c on a.category_id = c.id
        <if test="tagId != null">
            join article_tags at on a.id = at.article_id
        </if>
        <where>
            <if test="categoryId != null">
                and a.category_id = #{categoryId}
            </if>
            <if test="tagId != null">
                and at.tag_id = #{tagId}
            </if>
        </where>
    </select>

    <select id="selectArticlePage" resultMap="articleListItem">
        select a.id , a.title , a.cover_url , a.create_time , u.id as author_id , u.username as author_username , c.id
        as category_id ,
        c.name as category_name , (select count(*) from comments where comments.article_id = a.id) as comment_count from
        articles a join
        users u on u.id = a.author_id join categories c on a.category_id = c.id
        <if test="tagId != null">
            join article_tags at on a.id = at.article_id
        </if>
        <where>
            <if test="categoryId != null">
                and a.category_id = #{categoryId}
            </if>
            <if test="tagId != null">
                and at.tag_id = #{tagId}
            </if>
        </where>
        order by a.create_time
        <choose>
            <when test="isAsc">asc</when>
            <otherwise>desc</otherwise>
        </choose>
        , a.id
        <choose>
            <when test="isAsc">asc</when>
            <otherwise>desc</otherwise>
        </choose>
        limit #{nextData}, #{size}
    </select>

</mapper>